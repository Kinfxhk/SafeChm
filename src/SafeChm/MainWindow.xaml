<Window x:Class="SafeChm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SafeChm" Width="1200" Height="800"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="開啟" Click="OnOpen"/>
                <Button Content="匯出 HTML" Click="OnExport"/>
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="腳本已停用"/>
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <Grid DockPanel.Dock="Top" Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" VerticalContentAlignment="Center"
                             KeyDown="OnSearchKeyDown"/>
                    <Button Grid.Column="1" Content="搜尋" Click="OnSearch" Margin="4,0,0,0"/>
                    <Button Grid.Column="2" Content="目錄" Click="OnShowToc" Margin="4,0,0,0"/>
                </Grid>
                <Grid>
                    <TreeView x:Name="TocTree" SelectedItemChanged="OnTocSelected"/>
                    <ListBox x:Name="ResultsList" Visibility="Collapsed" SelectionChanged="OnResultSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Snippet}" Foreground="Gray" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <wv2:WebView2 x:Name="WebView" Grid.Column="2"/>
        </Grid>
    </DockPanel>
</Window>
